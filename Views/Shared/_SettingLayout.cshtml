<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - DBWineStore</title>
    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="@Url.Content("~/CSS/Setlayout.css")?v=99" />
</head>
<body>

    <div class="store-layout-container">
        <!-- Sidebar Navigation (Wine Settings Theme Style) -->
        <aside class="sidebar">
            <!-- Header with Home Arrow Link -->
            <div class="sidebar-header">
                <h2>DBWineStore</h2>
                <a href="@Url.Action("Index", "Store")" class="home-arrow-link" title="Quay về trang chủ">
                    <i class="fa-solid fa-arrow-left"></i> Trang chủ
                </a>
            </div>

            <div class="sidebar-category-label">Quản lý cửa hàng</div>

            @{
                // Helper to dynamically check active route
                string currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                string currentAction = ViewContext.RouteData.Values["action"]?.ToString();
            }

        <ul class="nav-links">
            <!-- Example: Active when Controller is 'Store' and Action is 'Index' -->
            <li class="@(currentController == "AccountManage" && currentAction == "Index" ? "active" : "")">
                @if (currentController == "AccountManage" && currentAction == "Index")
                {<span class="active-indicator"></span>}
                <a href="@Url.Action("Index", "AccountManage")">
                    <i class="fa-solid fa-users"></i>  <span class="placeholder-text">Danh mục Tk</span>
                </a>
            </li>
            
            <!-- Example for Cart / Orders -->
            <li class="@(currentController == "Categories" ? "active" : "")">
                @if (currentController == "Categories")
                {<span class="active-indicator"></span>}
                <a href="@Url.Action("Index", "Categories")">
                    <i class="fa-solid fa-receipt"></i> <span class="placeholder-text">Quan Ly Danh Muc</span>
                </a>
            </li>

            <!-- Example for Cart / Orders -->
            <li class="@(currentController == "AdminOrder" ? "active" : "")">
                @if (currentController == "AdminOrder")
                {<span class="active-indicator"></span>}
                <a href="@Url.Action("Index", "AdminOrder")">
                    <i class="fa-solid fa-receipt"></i> <span class="placeholder-text">Quan Ly đơn hàng</span>
                </a>
            </li>

            @*<li>
                <i class="fa-solid fa-chart-line"></i> <span class="placeholder-text"></span>
            </li>

            <li>
                <i class="fa-solid fa-users"></i> <span class="placeholder-text"></span>
            </li>
            <li>
                <i class="fa-solid fa-ticket"></i> <span class="placeholder-text">)</span>
            </li>

            <li>
                <i class="fa-solid fa-sliders"></i> <span class="placeholder-text"></span>
            </li>*@
        </ul>
        </aside>

        <main class="main-content">
            <div class="content-wrapper">
                @RenderBody()
            </div>
        </main>
    </div>

</body>
</html>