@model IEnumerable<DBWineStore.Models.AccountManageViewModel>

@{
    ViewBag.Title = "Account Management";
    Layout = "~/Views/Shared/_SettingLayout.cshtml";
}

<link rel="stylesheet" href="~/CSS/AccountIndex.css" />

<div class="account-page">
    <div class="page-header">
        <h1>Account Management</h1>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-error">@TempData["Error"]</div>
    }

    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Username</th>
                <th>Full Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>Status</th>
                <th>Created</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.UserID</td>
                    <td><strong>@item.UserName</strong></td>
                    <td>@item.FullName</td>
                    <td>@(string.IsNullOrEmpty(item.Email) ? "—" : item.Email)</td>
                    <td>
                        <span class="badge @(item.RoleName == "Admin" ? "badge-admin" : "badge-customer")">
                            @item.RoleName
                        </span>
                    </td>
                    <td>
                        <span class="badge @(item.IsActive ? "badge-active" : "badge-inactive")">
                            @(item.IsActive ? "Active" : "Inactive")
                        </span>
                    </td>
                    <td>@item.CreatedAt.ToString("dd/MM/yyyy")</td>
                    <td class="action-btns">
                        <a href="@Url.Action("Edit", new { id = item.UserID })" class="btn-edit">Edit</a>
                        <a href="@Url.Action("ToggleActive", new { id = item.UserID })" class="btn-toggle">
                            @(item.IsActive ? "Deactivate" : "Activate")
                        </a>
                        <a href="@Url.Action("Delete", new { id = item.UserID })"
                           class="btn-delete"
                           onclick="return confirm('Are you sure you want to delete this account?');">
                            Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>