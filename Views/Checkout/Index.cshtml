@model DBWineStore.Models.CheckoutViewModel

@{
    ViewBag.Title = "Thanh toán";
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
}

<style>
    .checkout-container {
        max-width: 850px;
        margin: 40px auto;
    }

    .checkout-box {
        background: white;
        padding: 25px;
        margin-bottom: 25px;
        border: 1px solid #ddd;
        border-radius: 10px;
    }

        .checkout-box h3 {
            margin-bottom: 20px;
            color: #713f12;
        }

        .checkout-box label {
            display: block;
            margin-bottom: 7px;
            font-weight: 600;
        }

        .checkout-box input,
        .checkout-box textarea {
            width: 100%;
            padding: 11px;
            margin-bottom: 15px;
            border: 1px solid #ccc;
            border-radius: 6px;
        }

    .payment-option {
        padding: 15px;
        border: 1px solid #ddd;
        border-radius: 8px;
        margin-bottom: 12px;
    }

        .payment-option input {
            width: auto;
            margin-right: 10px;
        }

    .checkout-submit {
        width: 100%;
        padding: 14px;
        background: #713f12;
        color: white;
        border: none;
        border-radius: 7px;
        font-size: 17px;
        cursor: pointer;
    }
</style>

<div class="checkout-container">

    ```
    <h2>THÔNG TIN THANH TOÁN</h2>

    @using (Html.BeginForm("Checkout", "Cart", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(false, "", new { @class = "text-danger" })

        <div class="checkout-box">

            <h3>Thông tin nhận hàng</h3>

            <label>Họ và tên</label>
            @Html.TextBoxFor(m => m.FullName,
                new { placeholder = "Nhập họ và tên" })
            @Html.ValidationMessageFor(m => m.FullName)

            <label>Số điện thoại</label>
            @Html.TextBoxFor(m => m.Phone,
                new { placeholder = "Nhập số điện thoại" })
            @Html.ValidationMessageFor(m => m.Phone)

            <label>Email</label>
            @Html.TextBoxFor(m => m.Email,
                new { placeholder = "Nhập email" })
            @Html.ValidationMessageFor(m => m.Email)

            <label>Địa chỉ nhận hàng</label>
            @Html.TextAreaFor(m => m.Address,
                new { placeholder = "Số nhà, đường, phường/xã, tỉnh/thành phố", rows = 3 })
            @Html.ValidationMessageFor(m => m.Address)

            <label>Ghi chú</label>
            @Html.TextAreaFor(m => m.Note,
                new { placeholder = "Ghi chú cho người bán (nếu có)", rows = 3 })

        </div>

        <div class="checkout-box">

            <h3>Phương thức thanh toán</h3>

            <div class="payment-option">
                <label>
                    @Html.RadioButtonFor(m => m.PaymentMethod, "COD")
                    Thanh toán khi nhận hàng (COD)
                </label>
            </div>

            <div class="payment-option">
                <label>
                    @Html.RadioButtonFor(m => m.PaymentMethod, "BankTransfer")
                    Chuyển khoản ngân hàng
                </label>
            </div>

            @Html.ValidationMessageFor(m => m.PaymentMethod)

        </div>
        <div class="checkout-box">
            <h3>Tóm tắt đơn hàng</h3>

            <p>
                Tạm tính:
                <strong>@Model.TotalAmount.ToString("N0")đ</strong>
            </p>

            <p>
                Giảm giá:
                <strong>@Model.DiscountAmount.ToString("N0")đ</strong>
            </p>

            <p>
                Phí giao hàng:
                <strong>
                    @(Model.ShippingFee == 0
                        ? "Miễn phí"
                        : Model.ShippingFee.ToString("N0") + "đ")
                </strong>
            </p>

            <hr />

            <h3>
                Tổng thanh toán:
                @Model.FinalAmount.ToString("N0")đ
            </h3>
        </div>
        <button type="submit" class="checkout-submit">
            XÁC NHẬN ĐẶT HÀNG
        </button>
    }
    ```

</div>
