@model DBWineStore.Models.CheckoutViewModel

@{
    ViewBag.Title = "Thanh toán";
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
}

<style>
.checkout-container {
    max-width: 880px;
    margin: 36px auto 60px;
    padding: 0 18px;
    font-family: Inter, system-ui, -apple-system, sans-serif;
    color: #2b1d1a;
}

.checkout-container h2 {
    font-size: 1.7rem;
    font-weight: 800;
    color: #4A0E18;
    margin: 0 0 22px;
    letter-spacing: 0.2px;
}

.checkout-box {
    background: #fff;
    padding: 24px 26px;
    margin-bottom: 18px;
    border: 1px solid #eee5dc;
    border-radius: 16px;
    box-shadow: 0 10px 28px rgba(74, 14, 24, 0.05);
}

.checkout-box h3 {
    margin: 0 0 18px;
    color: #4A0E18;
    font-size: 1.1rem;
    font-weight: 700;
}

.checkout-box label {
    display: block;
    margin-bottom: 7px;
    font-weight: 600;
    font-size: 0.88rem;
    color: #6b534a;
}

.checkout-box input[type="text"],
.checkout-box input[type="email"],
.checkout-box input[type="tel"],
.checkout-box textarea {
    width: 100%;
    padding: 12px 14px;
    margin-bottom: 14px;
    border: 1px solid #e5d8cc;
    border-radius: 10px;
    background: #faf8f6;
    color: #2b1d1a;
    font-size: 0.95rem;
    transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
    box-sizing: border-box;
}

.checkout-box input:focus,
.checkout-box textarea:focus {
    outline: none;
    border-color: #6B1E2A;
    background: #fff;
    box-shadow: 0 0 0 3px rgba(107, 30, 42, 0.12);
}

.payment-option {
    padding: 14px 16px;
    border: 1.5px solid #e8ddd3;
    border-radius: 12px;
    margin-bottom: 10px;
    background: #faf8f6;
    transition: border-color 0.2s, background 0.2s;
}

.payment-option:hover {
    border-color: #c9a08a;
    background: #fff;
}

.payment-option label {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-weight: 600;
    color: #3a2a26;
    cursor: pointer;
}

.payment-option input[type="radio"] {
    width: 18px;
    height: 18px;
    margin: 0;
    accent-color: #6B1E2A;
}

.checkout-box p {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 0 0 10px;
    font-size: 0.95rem;
    color: #5a4a45;
}

.checkout-box p strong {
    color: #2b1d1a;
    font-weight: 700;
}

.checkout-box hr {
    border: 0;
    border-top: 1px dashed #e5d8cc;
    margin: 14px 0;
}

.checkout-box h3:last-child {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 0;
    padding-top: 4px;
    color: #4A0E18;
    font-size: 1.25rem;
}

.checkout-submit {
    width: 100%;
    padding: 15px 18px;
    background: linear-gradient(135deg, #6B1E2A, #4A0E18);
    color: #fff;
    border: none;
    border-radius: 999px;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.3px;
    cursor: pointer;
    box-shadow: 0 10px 24px rgba(107, 30, 42, 0.28);
    transition: transform 0.15s, box-shadow 0.2s, filter 0.2s;
}

.checkout-submit:hover {
    filter: brightness(1.05);
    transform: translateY(-1px);
    box-shadow: 0 14px 28px rgba(107, 30, 42, 0.34);
}

.checkout-submit:active {
    transform: translateY(0);
}

.text-danger,
.field-validation-error {
    color: #c53030;
    font-size: 0.84rem;
    display: block;
    margin: -6px 0 12px;
}

@*@media (max-width: 640px) {
    .checkout-container {
        margin-top: 24px;
    }

    .checkout-box {
        padding: 18px;
        border-radius: 14px;
    }*@
}
</style>

<div class="checkout-container">

    
    <h2>THÔNG TIN THANH TOÁN</h2>
    
    @using (Html.BeginForm("Checkout", "Cart", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        

        <div class="checkout-box">

            <h3>Thông tin nhận hàng</h3>

            <label>Họ và tên</label>
            @Html.TextBoxFor(m => m.FullName,
                new { placeholder = "Nhập họ và tên" })
            @Html.ValidationMessageFor(m => m.FullName)

            <label>Số điện thoại</label>
            @Html.TextBoxFor(m => m.Phone,
                new { placeholder = "Nhập số điện thoại" })
            @Html.ValidationMessageFor(m => m.Phone)

            <label>Email</label>
            @Html.TextBoxFor(m => m.Email,
                new { placeholder = "Nhập email" })
            @Html.ValidationMessageFor(m => m.Email)

            <label>Địa chỉ nhận hàng</label>
            @Html.TextAreaFor(m => m.Address,
                new { placeholder = "Số nhà, đường, phường/xã, tỉnh/thành phố", rows = 3 })
            @Html.ValidationMessageFor(m => m.Address)

            <label>Ghi chú</label>
            @Html.TextAreaFor(m => m.Note,
                new { placeholder = "Ghi chú cho người bán (nếu có)", rows = 3 })

        </div>

        <div class="checkout-box">

            <h3>Phương thức thanh toán</h3>

            <div class="payment-option">
                <label>
                    @Html.RadioButtonFor(m => m.PaymentMethod, "COD")
                    Thanh toán khi nhận hàng (COD)
                </label>
            </div>

            <div class="payment-option">
                <label>
                    @Html.RadioButtonFor(m => m.PaymentMethod, "BANK")
                    Chuyển khoản ngân hàng
                </label>
            </div>

            @Html.ValidationMessageFor(m => m.PaymentMethod)

        </div>
        <div class="checkout-box">
            <h3>Tóm tắt đơn hàng</h3>

            <p>
                Tạm tính:
                <strong>@Model.TotalAmount.ToString("N0")đ</strong>
            </p>

            <p>
                Giảm giá:
                <strong>@Model.DiscountAmount.ToString("N0")đ</strong>
            </p>

            <p>
                Phí giao hàng:
                <strong>
                    @(Model.ShippingFee == 0
                        ? "Miễn phí"
                        : Model.ShippingFee.ToString("N0") + "đ")
                </strong>
            </p>

            <hr />

            <h3>
                Tổng thanh toán:
                @Model.FinalAmount.ToString("N0")đ
            </h3>
        </div>
        <button type="submit" class="checkout-submit">
            XÁC NHẬN ĐẶT HÀNG
        </button>
    }
   

</div>
