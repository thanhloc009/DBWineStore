@model List<DBWineStore.Models.CartItemViewModel>

@{
    ViewBag.Title = "Giỏ hàng";
    Layout = "~/Views/Shared/_StoreLayout.cshtml";

    decimal total = Model.Sum(x => x.Total);
}

<style>
    .cart-container {
        padding: 40px 0;
    }

    .cart-title {
        font-size: 30px;
        font-weight: bold;
        margin-bottom: 30px;
    }

    .cart-table {
        width: 100%;
        border-collapse: collapse;
        background: white;
    }

        .cart-table th,
        .cart-table td {
            padding: 15px;
            border-bottom: 1px solid #ddd;
            text-align: center;
        }

        .cart-table th {
            background: #f5f5f5;
        }

    .cart-image {
        width: 80px;
        height: 90px;
        object-fit: contain;
    }

    .quantity-btn {
        display: inline-block;
        padding: 5px 12px;
        background: #eee;
        text-decoration: none;
        color: black;
        border-radius: 4px;
    }

    .remove-btn {
        color: red;
        text-decoration: none;
    }

    .cart-total {
        text-align: right;
        margin-top: 25px;
        font-size: 22px;
        font-weight: bold;
    }

    .empty-cart {
        text-align: center;
        padding: 50px;
        font-size: 18px;
    }
</style>

<div class="cart-container">

    <h2 class="cart-title">Giỏ hàng của bạn</h2>

    @if (TempData["CartMessage"] != null)
    {
        <div class="alert alert-warning">
            @TempData["CartMessage"]
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="empty-cart">
            <p>Giỏ hàng của bạn đang trống!</p>

            <a href="@Url.Action("Index", "Store")"
               class="btn btn-primary">
                Tiếp tục mua sắm
            </a>
        </div>
    }
    else
    {
        <table class="cart-table">

            <thead>
                <tr>
                    <th>Hình ảnh</th>
                    <th>Sản phẩm</th>
                    <th>Đơn giá</th>
                    <th>Số lượng</th>
                    <th>Thành tiền</th>
                    <th>Thao tác</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <img class="cart-image"
                                 src="@Url.Content("~/Content/images/" + item.ImageUrl)"
                                 alt="@item.ProductName" />
                        </td>

                        <td>@item.ProductName</td>

                        <td>
                            @item.Price.ToString("#,##0") đ
                        </td>

                        <td>
                            <a class="quantity-btn"
                               href="@Url.Action("Decrease", "Cart", new { id = item.ProductID })">
                                -
                            </a>

                            <strong style="margin: 0 10px;">
                                @item.Quantity
                            </strong>

                            <a class="quantity-btn"
                               href="@Url.Action("Increase", "Cart", new { id = item.ProductID })">
                                +
                            </a>
                        </td>

                        <td>
                            @item.Total.ToString("#,##0") đ
                        </td>

                        <td>
                            <a class="remove-btn"
                               href="@Url.Action("Remove", "Cart", new { id = item.ProductID })"
                               onclick="return confirm('Bạn có chắc muốn xóa sản phẩm này?');">
                                Xóa
                            </a>
                        </td>
                    </tr>
                }

            </tbody>

        </table>

        <div class="coupon-box" style="margin-top:30px;">

            <h4>Mã giảm giá</h4>

            <div style="padding:15px; border:1px solid #ddd; border-radius:8px;">

                <strong>KM10 - Giảm 10%</strong>

                <p>Giảm 10% trên tổng giá trị đơn hàng.</p>

                @if (ViewBag.IsKM10 == true)
                {
                    <span style="color:green;">
                        Đã áp dụng mã KM10
                    </span>

                    <a href="@Url.Action("RemoveCoupon", "Cart")">
                        Bỏ mã
                    </a>
                }
                else
                {
                    <a href="@Url.Action("ApplyCoupon", "Cart")"
                       class="btn btn-success">
                        Chọn mã KM10
                    </a>
                }

            </div>


        </div>

        <div style="text-align:right; margin-top:25px;">

            <p>
                Tạm tính:
                @ViewBag.Total.ToString("#,##0") đ
            </p>

            <p style="color:green;">
                Giảm giá:
                -@ViewBag.Discount.ToString("#,##0") đ
            </p>
            <div class="cart-total-row">
                <span>Phí giao hàng:</span>
                <strong>
                    @(ViewBag.ShippingFee == 0
            ? "Miễn phí"
            : String.Format("{0:N0}đ", ViewBag.ShippingFee))
                </strong>
            </div>

            <h3>
                Tổng thanh toán:
                @String.Format("{0:N0}đ", ViewBag.FinalTotal) đ
            </h3>

        </div>

        <div style="text-align:right; margin-top:20px;">

            <a href="@Url.Action("Index", "Store")"
               class="btn btn-secondary">
                Tiếp tục mua hàng
            </a>

            <a href="@Url.Action("Checkout", "Cart")" class="btn btn-primary">
                Thanh toán
            </a>

        </div>
    }

</div>