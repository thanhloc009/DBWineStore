@model List<DBWineStore.Models.CartItemViewModel>

@{
    ViewBag.Title = "Giỏ hàng";
    Layout = "~/Views/Shared/_StoreLayout.cshtml";

    decimal total = Model.Sum(x => x.Total);
}

<style>
    .cart-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 36px 18px 60px;
    font-family: Inter, system-ui, -apple-system, sans-serif;
    color: #2b1d1a;
}

.cart-title {
    font-size: 1.85rem;
    font-weight: 800;
    margin: 0 0 22px;
    color: #4A0E18;
    letter-spacing: 0.2px;
}

.alert {
    padding: 12px 16px;
    border-radius: 10px;
    margin-bottom: 18px;
    font-size: 0.92rem;
}

.alert-warning {
    background: #fff6e8;
    border: 1px solid #f0d7a8;
    color: #8a5a12;
}

.cart-table {
    width: 100%;
    border-collapse: collapse;
    background: #fff;
    border: 1px solid #eee5dc;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 10px 28px rgba(74, 14, 24, 0.05);
}

.cart-table th,
.cart-table td {
    padding: 16px 14px;
    border-bottom: 1px solid #f0e8de;
    text-align: center;
    vertical-align: middle;
}

.cart-table th {
    background: #4A0E18;
    color: #f3e9eb;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.55px;
}

.cart-table tbody tr:last-child td {
    border-bottom: none;
}

.cart-table tbody tr:hover td {
    background: #faf7f2;
}

.cart-image {
    width: 78px;
    height: 88px;
    object-fit: contain;
    border-radius: 10px;
    background: #f8f4ec;
    padding: 4px;
    transition: transform 0.15s;
}

a:hover .cart-image {
    transform: scale(1.04);
}

.quantity-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: #f3ebe4;
    text-decoration: none;
    color: #4A0E18;
    border-radius: 8px;
    font-weight: 700;
    border: 1px solid #e5d8cc;
    transition: background 0.15s, color 0.15s;
}

.quantity-btn:hover {
    background: #6B1E2A;
    color: #fff;
    border-color: #6B1E2A;
}

.remove-btn {
    color: #c53030;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    padding: 6px 12px;
    border-radius: 8px;
    background: rgba(197, 48, 48, 0.08);
    border: 1px solid rgba(197, 48, 48, 0.18);
    transition: background 0.15s;
}

.remove-btn:hover {
    background: rgba(197, 48, 48, 0.16);
}

.coupon-box {
    margin-top: 22px;
    background: #fff;
    border: 1px solid #eee5dc;
    border-radius: 16px;
    padding: 20px 22px;
    box-shadow: 0 8px 22px rgba(74, 14, 24, 0.04);
}

.coupon-box h4 {
    margin: 0 0 12px;
    color: #4A0E18;
    font-size: 1.05rem;
}

.coupon-box > div {
    padding: 16px !important;
    border: 1px solid #eadfd4 !important;
    border-radius: 12px !important;
    background: #faf8f6;
}

.coupon-box strong {
    color: #6B1E2A;
}

.coupon-box p {
    margin: 8px 0 12px;
    color: #6b534a;
    font-size: 0.92rem;
}

.coupon-box .btn,
.coupon-box a.btn-success {
    display: inline-block;
    padding: 9px 16px;
    border-radius: 999px;
    background: #6B1E2A;
    color: #fff !important;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.88rem;
    border: none;
}

.coupon-box a:not(.btn):not(.btn-success) {
    margin-left: 10px;
    color: #c53030;
    font-weight: 600;
    text-decoration: none;
}

.cart-total-row {
    display: flex;
    justify-content: flex-end;
    gap: 18px;
    margin: 8px 0;
    color: #5a4a45;
}

.cart-total {
    text-align: right;
    margin-top: 18px;
    font-size: 1.35rem;
    font-weight: 800;
    color: #4A0E18;
}

.empty-cart {
    text-align: center;
    padding: 56px 24px;
    font-size: 1.05rem;
    background: #fff;
    border: 1px dashed #e5d8cc;
    border-radius: 16px;
    color: #6b534a;
}

.empty-cart .btn,
.cart-container .btn-primary,
.cart-container .btn-secondary {
    display: inline-block;
    margin-top: 8px;
    padding: 11px 18px;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.92rem;
}

.cart-container .btn-primary,
.empty-cart .btn-primary {
    background: linear-gradient(135deg, #6B1E2A, #4A0E18);
    color: #fff;
    border: none;
    box-shadow: 0 8px 18px rgba(107, 30, 42, 0.25);
}

.cart-container .btn-secondary {
    background: #fff;
    color: #4A0E18;
    border: 1px solid #e5d8cc;
    margin-right: 8px;
}

.cart-container .btn-secondary:hover {
    background: #faf7f2;
}

@*@media (max-width: 768px) {
    .cart-table {
        display: block;
        overflow-x: auto;
    }

    .cart-title {
        font-size: 1.5rem;
    }*@
}
</style>

<div class="cart-container">

    <h2 class="cart-title">Giỏ hàng của bạn</h2>

    @if (TempData["CartMessage"] != null)
    {
        <div class="alert alert-warning">
            @TempData["CartMessage"]
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="empty-cart">
            <p>Giỏ hàng của bạn đang trống!</p>

            <a href="@Url.Action("Index", "Store")"
               class="btn btn-primary">
                Tiếp tục mua sắm
            </a>
        </div>
    }
    else
    {
        <table class="cart-table">

            <thead>
                <tr>
                    <th>Hình ảnh</th>
                    <th>Sản phẩm</th>
                    <th>Đơn giá</th>
                    <th>Số lượng</th>
                    <th>Thành tiền</th>
                    <th>Thao tác</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <a href="@Url.Action("Details", "Products", new { id = item.ProductID })">
                                <img class="cart-image"
                                     src="@Url.Content("~/Content/images/" + item.ImageUrl)"
                                     alt="@item.ProductName" />
                            </a>
                        </td>

                        <td>@item.ProductName</td>

                        <td>
                            @item.Price.ToString("#,##0") đ
                        </td>

                        <td>
                            <a class="quantity-btn"
                               href="@Url.Action("Decrease", "Cart", new { id = item.ProductID })">
                                -
                            </a>

                            <strong style="margin: 0 10px;">
                                @item.Quantity
                            </strong>

                            <a class="quantity-btn"
                               href="@Url.Action("Increase", "Cart", new { id = item.ProductID })">
                                +
                            </a>
                        </td>

                        <td>
                            @item.Total.ToString("#,##0") đ
                        </td>

                        <td>
                            <a class="remove-btn"
                               href="@Url.Action("Remove", "Cart", new { id = item.ProductID })"
                               onclick="return confirm('Bạn có chắc muốn xóa sản phẩm này?');">
                                Xóa
                            </a>
                        </td>
                    </tr>
                }

            </tbody>

        </table>

        <div class="coupon-box" style="margin-top:30px;">

            <h4>Mã giảm giá</h4>

            <div style="padding:15px; border:1px solid #ddd; border-radius:8px;">

                <strong>KM10 - Giảm 10%</strong>

                <p>Giảm 10% trên tổng giá trị đơn hàng.</p>

                @if (ViewBag.IsKM10 == true)
                {
                    <span style="color:green;">
                        Đã áp dụng mã KM10
                    </span>

                    <a href="@Url.Action("RemoveCoupon", "Cart")">
                        Bỏ mã
                    </a>
                }
                else
                {
                    <a href="@Url.Action("ApplyCoupon", "Cart")"
                       class="btn btn-success">
                        Chọn mã KM10
                    </a>
                }

            </div>


        </div>

        <div style="text-align:right; margin-top:25px;">

            <p>
                Tạm tính:
                @ViewBag.Total.ToString("#,##0") đ
            </p>

            <p style="color:green;">
                Giảm giá:
                -@ViewBag.Discount.ToString("#,##0") đ
            </p>
            <div class="cart-total-row">
                <span>Phí giao hàng:</span>
                <strong>
                    @(ViewBag.ShippingFee == 0
            ? "Miễn phí"
            : String.Format("{0:N0}đ", ViewBag.ShippingFee))
                </strong>
            </div>

            <h3>
                Tổng thanh toán:
                @String.Format("{0:N0}đ", ViewBag.FinalTotal) đ
            </h3>

        </div>

        <div style="text-align:right; margin-top:20px;">

            <a href="@Url.Action("Index", "Store")"
               class="btn btn-secondary">
                Tiếp tục mua hàng
            </a>

            <a href="@Url.Action("Checkout", "Cart")" class="btn btn-primary">
                Thanh toán
            </a>

        </div>
    }

</div>