@model DBWineStore.Models.Product

@{
    ViewBag.Title = "Edit Product";
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
}

<link rel="stylesheet" href="@Url.Content("~/CSS/Edit.css")" />

<div class="edit-page">
    <div class="edit-container">
        <div class="edit-heading">
            <span class="edit-eyebrow">VIGNOBLE ADMINISTRATION</span>
            <h2>Edit Product</h2>
            <p>Update your product information and image.</p>
        </div>

        @using (Html.BeginForm("Edit", "Products", FormMethod.Post,
            new { enctype = "multipart/form-data", @class = "edit-form" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.ProductID)
            @Html.HiddenFor(m => m.ImageUrl) <!-- keep old image if no new file is uploaded -->

            @Html.ValidationSummary(false, "", new { @class = "validation-summary" })

            <div class="edit-grid">
                <!-- ========== Product Information ========== -->
                <div class="form-section">
                    <h3>Product Information</h3>

                    <div class="form-field">
                        @Html.LabelFor(m => m.ProductName, "Product Name")
                        @Html.TextBoxFor(m => m.ProductName, new
                        {
                            @class = "form-input",
                            placeholder = "Enter product name"
                        })
                        @Html.ValidationMessageFor(m => m.ProductName, "", new { @class = "field-error" })
                    </div>

                    <div class="form-field">
                        @Html.LabelFor(m => m.Description, "Description")
                        @Html.TextAreaFor(m => m.Description, new
                        {
                            @class = "form-input description-input",
                            placeholder = "Enter product description",
                            rows = 4
                        })
                        @Html.ValidationMessageFor(m => m.Description, "", new { @class = "field-error" })
                    </div>

                    <div class="form-field">
                        @Html.LabelFor(m => m.CategoryID, "Category")
                        @Html.DropDownList("CategoryID", null,
                                 "-- Select Category --",
                                 new { @class = "form-input" })
                        @Html.ValidationMessageFor(m => m.CategoryID, "", new { @class = "field-error" })
                    </div>

                    <div class="form-row">
                        <div class="form-field">
                            @Html.LabelFor(m => m.Price, "Price (VND)")
                            @Html.TextBoxFor(m => m.Price, "{0:0}", new
                            {
                                @class = "form-input",
                                type = "number",
                                step = "1",
                                min = "0"
                            })
                            @Html.ValidationMessageFor(m => m.Price, "", new { @class = "field-error" })
                        </div>

                        <div class="form-field">
                            @Html.LabelFor(m => m.StockQuantity, "Stock Quantity")
                            @Html.TextBoxFor(m => m.StockQuantity, new
                            {
                                @class = "form-input",
                                type = "number",
                                min = "0"
                            })
                            @Html.ValidationMessageFor(m => m.StockQuantity, "", new { @class = "field-error" })
                        </div>
                    </div>

                    <div class="form-field active-field">
                        <div>
                            <strong>Product Status</strong>
                            <small>Choose whether this product is available in your store.</small>
                        </div>
                        <label class="switch">
                            <input type="checkbox" id="IsActive" name="IsActive" value="true" checked="@(Model.IsActive ? "checked" : null)" />
                            <span class="switch-slider"></span>
                            <input type="hidden" name="IsActive" value="false" />
                        </label>
                    </div>
                </div>

                <!-- ========== Product Image ========== -->
                <div class="form-section image-section">
                    <h3>Product Image</h3>
                    <p class="section-description">Upload a new image to replace the current one.</p>

                    <div class="image-preview-box">
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <img src="~/Content/images/@Model.ImageUrl" alt="@Model.ProductName" />
                        }
                        
                    </div>

                    <label for="imageFile" class="upload-button">
                        <span>＋</span> Choose Image
                    </label>
                    <input type="file"
                           id="imageFile"
                           name="imageFile"
                           accept=".jpg,.jpeg,.png,.webp"
                           hidden />

                    <p id="fileName" class="file-name">No new image selected</p>
                    <p class="image-hint">Supported: JPG, JPEG, PNG, WEBP. Maximum 5 MB.</p>
                </div>
            </div>

            <div class="edit-actions">
                <a href="@Url.Action("Index", "Products")" class="back-button">Cancel</a>
                <button type="submit" class="save-button">Save Changes</button>
            </div>
        }
    </div>
</div>

<script>
    document.getElementById("imageFile").addEventListener("change", function () {
        const file = this.files[0];
        const fileNameEl = document.getElementById("fileName");
        const previewEl = document.getElementById("imagePreview");

        if (file) {
            if (file.size > 5 * 1024 * 1024) {
                alert("Image is larger than 5 MB. Please choose a smaller file.");
                this.value = "";
                fileNameEl.textContent = "No new image selected";
                return;
            }

            fileNameEl.textContent = file.name;

            const reader = new FileReader();
            reader.onload = function (e) {
                previewEl.src = e.target.result;
            };
            reader.readAsDataURL(file);
        } else {
            fileNameEl.textContent = "No new image selected";
        }
    });
</script>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
