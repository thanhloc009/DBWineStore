
@model DBWineStore.Models.Product

@{
    ViewBag.Title = "Create New Wine";
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
}

<link rel="stylesheet" href="~/CSS/create.css" />

<div class="create-page">
    <div class="create-container">

        <div class="create-heading">
            <span class="create-eyebrow">VIGNOBLE ADMINISTRATION</span>
            <h2>Create New Wine</h2>
            <p>Add a new product to your wine collection.</p>
        </div>

        @using (Html.BeginForm("Create", "Products", FormMethod.Post,
            new { enctype = "multipart/form-data", @class = "create-form" }))
        {
            @Html.AntiForgeryToken()

            <div class="create-grid">

                <!-- PRODUCT INFORMATION -->
                <div class="form-section">
                    <h3>Product Information</h3>

                    @Html.ValidationSummary(true, "", new { @class = "validation-summary" })

                    <div class="form-field">
                        @Html.LabelFor(m => m.ProductName, "Product Name")
                        @Html.TextBoxFor(m => m.ProductName,
                            new { @class = "form-input", placeholder = "Enter product name" })
                        @Html.ValidationMessageFor(m => m.ProductName, "", new { @class = "field-error" })
                    </div>

                    <div class="form-field">
                        @Html.LabelFor(m => m.Description, "Description")
                        @Html.TextAreaFor(m => m.Description,
                            new { @class = "form-input description-input", placeholder = "Enter product description" })
                        @Html.ValidationMessageFor(m => m.Description, "", new { @class = "field-error" })
                    </div>

                    <div class="form-field">
                        @Html.LabelFor(m => m.CategoryID, "Category")
                        @Html.DropDownList("CategoryID", null,
                            "-- Select Category --",
                            new { @class = "form-input" })
                        @Html.ValidationMessageFor(m => m.CategoryID, "", new { @class = "field-error" })
                    </div>

                    <div class="form-row">
                        <div class="form-field">
                            @Html.LabelFor(m => m.Price, "Price (VND)")
                            @Html.TextBoxFor(m => m.Price, "{0:0}",
                                new { @class = "form-input", type = "number", step = "1", min = "0", placeholder = "Example: 790000" })
                            @Html.ValidationMessageFor(m => m.Price, "", new { @class = "field-error" })
                        </div>

                        <div class="form-field">
                            @Html.LabelFor(m => m.StockQuantity, "Stock Quantity")
                            @Html.TextBoxFor(m => m.StockQuantity,
                                new { @class = "form-input", type = "number", min = "0", placeholder = "Enter quantity" })
                            @Html.ValidationMessageFor(m => m.StockQuantity, "", new { @class = "field-error" })
                        </div>
                    </div>

                    <div class="form-field active-field">
                        <div>
                            <strong>Product Status</strong>
                            <small>Choose whether this product is available in your store.</small>
                        </div>

                        <label class="switch">
                            @Html.CheckBoxFor(m => m.IsActive)
                            <span class="switch-slider"></span>
                        </label>
                    </div>
                </div>

                <!-- IMAGE UPLOAD -->
                <div class="form-section image-section">
                    <h3>Product Image</h3>
                    <p class="section-description">
                        Choose an image from your computer.
                    </p>

                    <div class="image-preview-box">
                        <img id="imagePreview"
                             src="@Url.Content("~/Content/images/no-image.png")"
                             alt="Product preview" />
                    </div>

                    <label for="imageFile" class="upload-button">
                        <span>＋</span> Choose Image
                    </label>

                    <input type="file"
                           id="imageFile"
                           name="imageFile"
                           accept=".jpg,.jpeg,.png,.webp"
                           hidden />

                    <p id="fileName" class="file-name">No image selected</p>

                    <p class="image-hint">
                        Supported formats: JPG, JPEG, PNG, WEBP.
                        Maximum size: 5 MB.
                    </p>
                </div>

            </div>

            <!-- ACTIONS -->
            <div class="create-actions">
                <a href="@Url.Action("Index", "Product")" class="back-button">
                    Cancel
                </a>

                <button type="submit" class="save-button">
                    Create Wine
                </button>
            </div>
        }
    </div>
</div>

<script>
    document.getElementById("imageFile").addEventListener("change", function () {
        const file = this.files[0];

        if (file) {
            document.getElementById("fileName").textContent = file.name;

            const reader = new FileReader();

            reader.onload = function (e) {
                document.getElementById("imagePreview").src = e.target.result;
            };

            reader.readAsDataURL(file);
        }
    });
</script>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
