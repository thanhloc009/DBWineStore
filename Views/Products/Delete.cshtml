@model DBWineStore.Models.Product

@{
    ViewBag.Title = "Xóa sản phẩm";
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
}

<link rel="stylesheet" href="@Url.Content("~/CSS/product-delete.css")?v=1" />

<div class="del-page">
    <div class="del-card">

        <div class="del-head">
            <span class="del-icon"><i class="fa-solid fa-triangle-exclamation"></i></span>
            <div>
                <h2>Xóa sản phẩm</h2>
                <p>Bạn có chắc muốn xóa sản phẩm này? Thao tác không thể hoàn tác.</p>
            </div>
        </div>

        <div class="del-body">
            <div class="del-image">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Url.Content("~/Content/images/" + Model.ImageUrl)" alt="@Model.ProductName" />
                }
                else
                {
                    <i class="fa-solid fa-wine-bottle"></i>
                }
            </div>

            <dl class="del-info">
                <div><dt>Tên sản phẩm</dt><dd class="strong">@Model.ProductName</dd></div>
                <div><dt>Danh mục</dt><dd>@(Model.Category != null ? Model.Category.CategoryName : "-")</dd></div>
                <div><dt>Giá</dt><dd>@String.Format("{0:N0} ₫", Model.Price)</dd></div>
                <div><dt>Tồn kho</dt><dd>@Model.StockQuantity</dd></div>
                <div>
                    <dt>Trạng thái</dt>
                    <dd>
                        <span class="del-badge @(Model.IsActive ? "on" : "off")">@(Model.IsActive ? "Đang bán" : "Ngừng bán")</span>
                    </dd>
                </div>
                <div><dt>Mô tả</dt><dd>@(string.IsNullOrWhiteSpace(Model.Description) ? "-" : Model.Description)</dd></div>
            </dl>
        </div>

        <p class="del-note">
            <i class="fa-solid fa-circle-info"></i>
            Nếu sản phẩm đã có trong đơn hàng, bạn sẽ không xóa được — hãy chuyển sang “Ngừng bán”.
        </p>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="del-actions">
                <button type="submit" class="del-btn danger"><i class="fa-solid fa-trash"></i> Xóa</button>
                @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "del-btn ghost" })
            </div>
        }
    </div>
</div>
