@model IEnumerable<DBWineStore.Models.Product>

@{
    ViewBag.Title = "Our Wines";
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
}
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;700&display=swap" rel="stylesheet">
<link href="~/CSS/Index2.css" rel="stylesheet" />

<style>
    .product-img-wrapper {
        position: relative;
        height: 220px;
        overflow: hidden;
        background: #f5f0eb;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .product-img-wrapper img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            display: block;
        }

    .active-badge {
        position: absolute;
        top: 10px;
        left: 10px;
        z-index: 2;
        padding: 3px 10px;
        border-radius: 999px;
        font-size: 0.72rem;
        font-weight: 600;
        color: #fff;
        box-shadow: 0 1px 4px rgba(0,0,0,.25);
    }

        .active-badge.is-active {
            background: #2e7d32;
        }

        .active-badge.is-inactive {
            background: #8d8d8d;
        }

    .product-card.inactive .product-img-wrapper img {
        opacity: .55;
        filter: grayscale(.6);
    }

    .no-img-fallback {
        color: #bbb;
        font-size: 3rem;
    }
</style>

<div class="store-shell" id="featured-products">
    <div class="wine-header text-center">
        <div class="container">
            <h1>Our Wine Collection</h1>
            <p class="mb-0">Discover exceptional wines carefully selected for you</p>
        </div>
    </div>

    <div class="container">
        <div class="create">
            <h4 class="mb-0" style="color: var(--wine-dark); font-family: 'Playfair Display', serif;">
                All Products (@Model.Count())
            </h4>
            @Html.ActionLink("＋ Create New Wine", "Create", "Products", null, new { @class = "btn btn-wine" })
        </div>

        @if (!Model.Any())
        {
            <div class="empty-state">
                <h3>No wines found</h3>
                <p>Start by adding your first product.</p>
            </div>
        }
        else
        {
            <div class="item">
                @foreach (var item in Model)
                {
                    string imageFile = item.ImageUrl;
                    if (!string.IsNullOrWhiteSpace(imageFile))
                    {
                        imageFile = imageFile.Replace("\\", "/");
                        if (imageFile.Contains("/"))
                        {
                            imageFile = imageFile.Substring(imageFile.LastIndexOf('/') + 1);
                        }
                    }

                    string imageSrc = string.IsNullOrWhiteSpace(imageFile)
                        ? null
                        : Url.Content("~/Content/images/" + Uri.EscapeDataString(imageFile));

                    <div class="col">
                        <div class="card product-card @(item.IsActive ? "" : "inactive")">
                            <div class="product-img-wrapper">
                                <span class="active-badge @(item.IsActive ? "is-active" : "is-inactive")">
                                    @(item.IsActive ? "Active" : "Inactive")
                                </span>

                                @if (!string.IsNullOrEmpty(imageSrc))
                                {
                                    <img src="@imageSrc"
                                         alt="@item.ProductName"
                                         onerror="this.onerror=null; this.style.display='none'; this.parentElement.insertAdjacentHTML('beforeend','<div class=&quot;no-img-fallback&quot;>🍷</div>');" />
                                }
                                else
                                {
                                    <div class="no-img-fallback">🍷</div>
                                }
                            </div>

                            <div class="product-body">
                                <div class="product-category">
                                    @(item.Category?.CategoryName ?? "Uncategorized")
                                </div>
                                <h5 class="product-name">@item.ProductName</h5>
                                <div class="product-meta">
                                    @if (!string.IsNullOrEmpty(item.Description))
                                    {
                                        @(item.Description.Length > 80
                                            ? item.Description.Substring(0, 80) + "..."
                                            : item.Description)
                                    }
                                </div>
                                <div class="item2">
                                    <div class="product-price">@item.Price.ToString("#,##0") đ</div>
                                    @{
                                        var stockClass = item.StockQuantity > 20 ? "badge-in-stock" :
                                                         item.StockQuantity > 0 ? "badge-low-stock" : "badge-out";
                                        var stockText = item.StockQuantity > 20 ? "In Stock" :
                                                        item.StockQuantity > 0 ? "Low Stock" : "Out of Stock";
                                    }
                                    <span class="stock-badge @stockClass">@stockText (@item.StockQuantity)</span>
                                </div>
                                <div class="item3">
                                    @Html.ActionLink("Edit", "Edit", "Products", new { id = item.ProductID }, null)
                                    @Html.ActionLink("Details", "Details", "Products", new { id = item.ProductID }, null)
                                    @Html.ActionLink("Delete", "Delete", "Products", new { id = item.ProductID }, null)
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>